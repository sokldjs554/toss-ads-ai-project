# 둘 다 비워도 실행됩니다 (DEMO 모드: LLM 단계는 결정론적 대역이 수행하고, 가드레일·관측·평가는 실제 코드가 동작)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 라우팅 기본값 (공고 기준: 구조화 평가/심사 = GPT-4o Structured Outputs, 창의 생성/가상 피드백 = Claude Sonnet)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5-5

# 한 번의 파이프라인 실행에 허용하는 최대 비용(USD). 초과하면 FM-20 BudgetExceeded 로 fail-closed
PREFLIGHT_RUN_BUDGET_USD=0.50
# 자동 승인에 필요한 최소 보정 신뢰도. 평가셋 reliability diagram 으로 재산정 (evals/reports/baseline.json)
PREFLIGHT_AUTO_DECISION_CONFIDENCE=0.80
